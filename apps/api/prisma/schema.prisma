generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum PetType {
  DOUYA
  PAOPAO
  TUANTUAN
  MILU
  SHANSHAN
}

enum PetGrowthStage {
  BABY
  GROWING
  MATURE
}

enum PetCareKind {
  FEED
  DRINK
}

enum PetTravelTier {
  NEARBY
  CHINA
  WORLD
}

enum PetTripStatus {
  TRAVELING
  RETURNED
  REVEALED
  CANCELLED
}

enum PetRoomMascotMotion {
  IDLE
  CLOUD_FLOAT
  UNDERWATER_SWIM
  PETAL_SWAY
  STARGAZE
  ZERO_GRAVITY
  SPORT_BOUNCE
  ADVENTURE_MARCH
}

enum TaskCategory {
  READING
  MATH
  EXERCISE
  CHORES
  ORGANIZING
  MUSIC
  CHINESE
  ENGLISH
  PE
  OTHER
}

enum TaskMode {
  UNTIMED
  TIMED
}

enum TaskExperienceKind {
  STANDARD
  HANZI_LEARNING
  HANZI_REVIEW
  CLOCK_LEARNING
  MAKE_TEN
  MATH_PRACTICE
  POEM_LEARNING
  POEM_REVIEW
}

enum ScheduleKind {
  DAILY
  WORKDAYS
  SELECTED_WEEKDAYS
  ONE_TIME
}

enum DailyTaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

enum AttemptStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  ROLLED_BACK
  TIMED_OUT
  ABANDONED
  DAY_ENDED
}

enum WishCategory {
  SPORTS
  GAMES
  TELEVISION
  TOYS
}

enum RedemptionStatus {
  PENDING
  ARRANGED
  COMPLETED
  CANCELLED
}

enum WishRedemptionType {
  ONE_TIME
  RECURRING
  STOCK
}

enum WishRecurrenceKind {
  DAILY
  WEEKLY
  INTERVAL
}

enum StarLedgerType {
  TASK_REWARD
  TASK_REWARD_REVERSAL
  DAILY_GOAL_BONUS
  PLANET_BONUS
  WISH_SPEND
  WISH_REFUND
  PET_CARE_SPEND
  PET_TRAVEL_SPEND
  PET_ROOM_THEME_SPEND
  PET_RED_PACKET_REWARD
  PET_REFUND
  MANUAL_ADJUSTMENT
}

enum PlanetKey {
  MERCURY
  VENUS
  EARTH
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
}

enum AuditActorType {
  CHILD
  USER
  SYSTEM
}

enum LearningPracticeKind {
  GENERAL
  NEW_CONTENT
  REVIEW
  MIXED
}

enum HanziLearningStatus {
  LEARNING
  MASTERED
}

enum HanziSessionPhase {
  REVIEW
  NEW_LEARNING
  CONSOLIDATION
  COMPLETED
}

enum HanziSessionKind {
  COMBINED_LEGACY
  LEARNING
  REVIEW
}

enum PoemLearningStatus {
  LEARNING
  MASTERED
}

enum PoemSessionKind {
  LEARNING
  REVIEW
}

enum AiRecommendationKind {
  TASK_ADVICE
  REWARD_AUDIT
  SCHEDULE
}

enum AiRecommendationStatus {
  DRAFT
  APPLIED
  DISMISSED
}

enum WeeklyGrowthReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum ChallengeConversationStatus {
  GENERATING
  READY
  FAILED
}

enum ChallengeMessageSender {
  VIRTUAL_PARTNER
  CHILD
}

model Family {
  id        String        @id @default(cuid())
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users                User[]
  children             ChildProfile[]
  aiConfig             FamilyAiConfig?
  minimaxConfig        FamilyMinimaxConfig?
  aiRecommendations    AiRecommendation[]
  weeklyGrowthReports  WeeklyGrowthReport[]
  petRoomThemeSettings FamilyPetRoomThemeSetting[]
  petRoomThemes        PetRoomTheme[]
  travelPackingList    TravelPackingList?

  @@index([status])
}

model User {
  id           String        @id @default(cuid())
  familyId     String?
  username     String        @unique
  displayName  String
  passwordHash String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  family   Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@index([familyId, role])
  @@index([status])
}

model TravelPackingList {
  id        String   @id @default(cuid())
  familyId  String   @unique
  title     String   @default("下一次旅行")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family     Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categories TravelPackingCategory[]
  shares     TravelPackingShare[]
  todos      TravelPackingTodo[]
}

model TravelPackingTodo {
  id        String   @id @default(cuid())
  listId    String
  label     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list TravelPackingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, completed, sortOrder])
}

model TravelPackingShare {
  id        String   @id @default(cuid())
  listId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list TravelPackingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, expiresAt])
}

model TravelPackingCategory {
  id        String   @id @default(cuid())
  listId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list  TravelPackingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  items TravelPackingItem[]

  @@index([listId, sortOrder])
}

model TravelPackingItem {
  id         String   @id @default(cuid())
  categoryId String
  label      String
  quantity   Int      @default(1)
  packed     Boolean  @default(false)
  location   String   @default("SUITCASE")
  expirationDate String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category TravelPackingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
}


model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ChildProfile {
  id                    String        @id @default(cuid())
  familyId              String
  loginCodeLookup       String        @unique
  loginCodeHash         String
  loginCodeLastFour     String
  status                AccountStatus @default(ACTIVE)
  nickname              String?
  avatarUrl             String?
  petType               PetType?
  taskDashboardLayout   Json?
  onboardingCompletedAt DateTime?
  dailyStarGoal         Int           @default(12)
  dailyGoalBonusEnabled Boolean       @default(false)
  dailyGoalBonusStars   Int           @default(0)
  starBalance           Int           @default(0)
  lifetimeStarsEarned   Int           @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  family                  Family                        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions                ChildSession[]
  taskTemplates           TaskTemplate[]
  dailyTasks              DailyTask[]
  taskAttempts            TaskAttempt[]
  activeTaskSlot          ActiveTaskSlot?
  starLedger              StarLedger[]
  wishRewards             WishReward[]
  redemptions             WishRedemption[]
  schedulePreference      ChildSchedulePreference?
  availabilitySlots       ChildAvailabilitySlot[]
  aiRecommendations       AiRecommendation[]
  weeklyGrowthReports     WeeklyGrowthReport[]
  planetProgress          PlanetProgress[]
  hanziSettings           HanziLearningSettings?
  hanziProgress           HanziLearningProgress[]
  hanziSessions           HanziLearningSession[]
  clockSettings           ClockLearningSettings?
  clockSessions           ClockLearningSession[]
  makeTenSettings         MakeTenLearningSettings?
  makeTenSessions         MakeTenLearningSession[]
  makeTenQuestionAttempts MakeTenQuestionAttempt[]
  makeTenFactProgress     MakeTenFactProgress[]
  mathPracticeSettings    MathPracticeSettings?
  mathPracticeSessions    MathPracticeSession[]
  mathPracticeAttempts    MathPracticeQuestionAttempt[]
  poemSettings            PoemLearningSettings?
  poemProgress            PoemLearningProgress[]
  poemSessions            PoemLearningSession[]
  performanceMetrics      ChildPerformanceMetric[]
  leaderboardSettings     ChildLeaderboardSettings?
  petGrowthProfile        PetGrowthProfile?
  petCareActions          PetCareAction[]
  petTrips                PetTrip[]
  petRoomThemeUnlocks     PetRoomThemeUnlock[]
  petRedPackets           PetRedPacket[]
  petWasteOccurrences     PetWasteOccurrence[]
  challengeConversations  ChallengeConversation[]

  @@index([familyId, status])
}

model PetGrowthProfile {
  id                    String         @id @default(cuid())
  childId               String         @unique
  level                 Int            @default(1)
  experience            Int            @default(0)
  growthStage           PetGrowthStage @default(BABY)
  satiety               Int            @default(78)
  hydration             Int            @default(82)
  satietySettledAt      DateTime       @default(now())
  hydrationSettledAt    DateTime       @default(now())
  satietyDecayMinutes   Int?
  hydrationDecayMinutes Int?
  dailyWasteCount       Int            @default(2)
  wasteCleanCostStars   Int            @default(1)
  travelEnabled         Boolean        @default(true)
  dailySpendLimitStars  Int?
  redPacketsPerLevel    Int            @default(1)
  redPacketMinStars     Int            @default(1)
  redPacketMaxStars     Int            @default(5)
  equippedRoomThemeId   String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  child             ChildProfile         @relation(fields: [childId], references: [id], onDelete: Cascade)
  equippedRoomTheme PetRoomTheme?        @relation(fields: [equippedRoomThemeId], references: [id], onDelete: SetNull)
  careActions       PetCareAction[]
  trips             PetTrip[]
  redPackets        PetRedPacket[]
  wasteOccurrences  PetWasteOccurrence[]
}

model PetWasteOccurrence {
  id                  String    @id @default(cuid())
  childId             String
  profileId           String
  wasteDate           DateTime  @db.Date
  sequence            Int
  appearsMinute       Int
  positionSeed        Int
  costStarsSnapshot   Int
  snoozedUntil        DateTime?
  cleanIdempotencyKey String?   @unique
  cleanedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  child   ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile PetGrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([childId, wasteDate, sequence])
  @@index([childId, wasteDate, cleanedAt, appearsMinute])
}

model PetRedPacket {
  id               String    @id @default(cuid())
  childId          String
  profileId        String
  sourceLevel      Int
  minStarsSnapshot Int
  maxStarsSnapshot Int
  rewardStars      Int?
  grantKey         String    @unique
  claimKey         String?   @unique
  openedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  child   ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile PetGrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([childId, openedAt, createdAt])
  @@index([profileId, sourceLevel])
}

model PetRoomTheme {
  id                     String              @id
  key                    String              @unique
  ownerFamilyId          String?
  name                   String
  description            String
  priceStars             Int
  backgroundLandscapeUrl String
  backgroundTabletUrl    String
  backgroundPhoneUrl     String
  previewUrl             String
  ambience               Json
  mascotMotion           PetRoomMascotMotion @default(IDLE)
  sortOrder              Int                 @default(0)
  isEnabled              Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  ownerFamily      Family?                       @relation(fields: [ownerFamilyId], references: [id], onDelete: Cascade)
  equippedProfiles PetGrowthProfile[]
  unlocks          PetRoomThemeUnlock[]
  familySettings   FamilyPetRoomThemeSetting[]
  mascotAnimations PetRoomThemeMascotAnimation[]

  @@index([isEnabled, sortOrder])
  @@index([ownerFamilyId, isEnabled, sortOrder])
}

model PetRoomThemeMascotAnimation {
  id              String   @id @default(cuid())
  themeId         String
  petType         PetType
  mediaUrl        String
  contentType     String
  fileName        String
  sourceWidth     Int
  sourceHeight    Int
  frameCount      Int      @default(1)
  outputBytes     Int
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  theme PetRoomTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, petType])
  @@index([petType])
}

model FamilyPetRoomThemeSetting {
  id         String   @id @default(cuid())
  familyId   String
  themeId    String
  priceStars Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  theme  PetRoomTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([familyId, themeId])
  @@index([familyId])
}

model PetRoomThemeUnlock {
  id                 String   @id @default(cuid())
  childId            String
  themeId            String
  priceStarsSnapshot Int
  idempotencyKey     String   @unique
  purchasedAt        DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  theme PetRoomTheme @relation(fields: [themeId], references: [id], onDelete: Restrict)

  @@unique([childId, themeId])
  @@index([childId, purchasedAt])
}

model PetCareAction {
  id              String      @id @default(cuid())
  childId         String
  profileId       String
  kind            PetCareKind
  itemKey         String
  starsSpent      Int
  statusBefore    Int
  statusAfter     Int
  experienceAdded Int
  idempotencyKey  String      @unique
  createdAt       DateTime    @default(now())

  child   ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile PetGrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
}

model PetTravelDestination {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  city         String
  country      String
  tier         PetTravelTier
  introduction String
  funFact      String
  imageUrl     String
  audioUrl     String?
  weight       Int           @default(100)
  sortOrder    Int           @default(0)
  isEnabled    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trips PetTrip[]

  @@index([tier, isEnabled, sortOrder])
}

model PetTrip {
  id                       String        @id @default(cuid())
  childId                  String
  profileId                String
  destinationId            String
  status                   PetTripStatus @default(TRAVELING)
  tierSnapshot             PetTravelTier
  destinationNameSnapshot  String
  citySnapshot             String
  countrySnapshot          String
  introductionSnapshot     String
  funFactSnapshot          String
  imageUrlSnapshot         String
  audioUrlSnapshot         String?
  costStars                Int
  experienceRewardSnapshot Int
  experienceAwarded        Int           @default(0)
  departedAt               DateTime      @default(now())
  returnsAt                DateTime
  returnedAt               DateTime?
  revealedAt               DateTime?
  idempotencyKey           String        @unique
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  child       ChildProfile         @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile     PetGrowthProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  destination PetTravelDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([childId, status, departedAt])
  @@index([destinationId, departedAt])
}

model PetGrowthConfig {
  id                    String   @id @default("global")
  feedCostStars         Int      @default(2)
  feedRestore           Int      @default(28)
  feedExperience        Int      @default(6)
  drinkCostStars        Int      @default(1)
  drinkRestore          Int      @default(32)
  drinkExperience       Int      @default(4)
  satietyDecayMinutes   Int      @default(120)
  hydrationDecayMinutes Int      @default(90)
  nearbyCostStars       Int      @default(3)
  nearbyDurationMinutes Int      @default(2)
  nearbyExperience      Int      @default(12)
  chinaCostStars        Int      @default(10)
  chinaDurationMinutes  Int      @default(30)
  chinaExperience       Int      @default(24)
  worldCostStars        Int      @default(18)
  worldDurationMinutes  Int      @default(120)
  worldExperience       Int      @default(40)
  updatedAt             DateTime @updatedAt
}

model ChildSession {
  id         String   @id @default(cuid())
  childId    String
  tokenHash  String   @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, expiresAt])
}

model TaskTemplate {
  id                    String               @id @default(cuid())
  childId               String
  title                 String
  category              TaskCategory
  iconKey               String
  mode                  TaskMode
  experienceKind        TaskExperienceKind   @default(STANDARD)
  suggestedSeconds      Int?
  timeLimitSeconds      Int?
  baseStars             Int
  earlyBonusEnabled     Boolean              @default(false)
  earlyThresholdSeconds Int?
  earlyBonusStars       Int?
  repeatableDaily       Boolean              @default(false)
  scheduleKind          ScheduleKind
  weekdays              Int[]                @default([])
  oneTimeDate           DateTime?            @db.Date
  sortOrder             Int                  @default(0)
  isEnabled             Boolean              @default(true)
  archivedAt            DateTime?
  aiSchedulingEnabled   Boolean              @default(false)
  learningPracticeKind  LearningPracticeKind @default(GENERAL)
  targetSessionsPerWeek Int?
  minimumGapDays        Int?
  systemManaged         Boolean              @default(false)
  systemKey             String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  child              ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyTasks         DailyTask[]
  mathPracticeConfig MathPracticeConfig?

  @@index([childId, isEnabled, archivedAt])
  @@index([childId, scheduleKind, oneTimeDate])
}

model FamilyAiConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  provider        String   @default("DEEPSEEK")
  model           String   @default("deepseek-v4-flash")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model SystemAiConfig {
  id              String   @id @default("default")
  provider        String   @default("DEEPSEEK")
  model           String   @default("deepseek-v4-flash")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChallengePromptTemplate {
  id         String   @id @default(cuid())
  text       String   @unique
  isEnabled  Boolean  @default(true)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isEnabled, createdAt])
}

model ChallengeConversation {
  id                  String                      @id @default(cuid())
  childId             String
  businessDate        DateTime                    @db.Date
  competitorId        String
  competitorName      String
  competitorAvatarKey String
  status              ChallengeConversationStatus @default(GENERATING)
  openedAt            DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  child    ChildProfile              @relation(fields: [childId], references: [id], onDelete: Cascade)
  messages ChallengeConversationMessage[]

  @@unique([childId, businessDate, competitorId])
  @@index([childId, status, businessDate])
}

model ChallengeConversationMessage {
  id             String                 @id @default(cuid())
  conversationId String
  sender         ChallengeMessageSender
  text           String
  model          String?
  visibleAt      DateTime               @default(now())
  readAt         DateTime?
  createdAt      DateTime               @default(now())

  conversation ChallengeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, visibleAt])
  @@index([sender, readAt, visibleAt])
}

model FamilyMinimaxConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  provider        String   @default("MINIMAX")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model SystemMinimaxConfig {
  id              String   @id @default("default")
  provider        String   @default("MINIMAX")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MascotDialogue {
  id        String   @id @default(cuid())
  key       String   @unique
  context   String
  text      String
  audioUrl  String?
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([context, isEnabled, sortOrder])
}

model MascotAsset {
  id              String   @id @default(cuid())
  petType         PetType
  slot            String
  mediaUrl        String
  contentType     String
  fileName        String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petType, slot])
  @@index([slot])
}

model ChildLeaderboardSettings {
  id                         String    @id @default(cuid())
  childId                    String    @unique
  competitorGrowthPercent    Int       @default(100)
  dailyCompetitorStarDelta   Int       @default(0)
  dailyAdjustmentDate        DateTime? @db.Date
  speedAnchorDate            DateTime? @db.Date
  speedAnchorMinute          Int       @default(0)
  speedAnchorEffectiveMinute Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildSchedulePreference {
  id                    String   @id @default(cuid())
  childId               String   @unique
  maxDailyMinutes       Int      @default(40)
  maxConsecutiveMinutes Int      @default(15)
  minimumBreakMinutes   Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildAvailabilitySlot {
  id          String   @id @default(cuid())
  childId     String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, weekday, startMinute])
}

model AiRecommendation {
  id              String                 @id @default(cuid())
  familyId        String
  childId         String
  kind            AiRecommendationKind
  status          AiRecommendationStatus @default(DRAFT)
  promptVersion   String
  model           String
  requestPayload  Json
  responsePayload Json
  createdById     String
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, childId, kind, createdAt])
  @@index([status, createdAt])
}

model WeeklyGrowthReport {
  id              String                   @id @default(cuid())
  familyId        String
  childId         String
  weekStart       DateTime                 @db.Date
  weekEnd         DateTime                 @db.Date
  status          WeeklyGrowthReportStatus @default(GENERATING)
  promptVersion   String
  model           String?
  metricsPayload  Json
  responsePayload Json?
  errorCode       String?
  generatedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekStart])
  @@index([familyId, childId, weekStart])
  @@index([status, updatedAt])
}

model DailyTask {
  id                         String             @id @default(cuid())
  childId                    String
