generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum PetType {
  DOUYA
  PAOPAO
  TUANTUAN
  MILU
  SHANSHAN
}

enum PetGrowthStage {
  BABY
  GROWING
  MATURE
}

enum PetCareKind {
  FEED
  DRINK
}

enum PetTravelTier {
  NEARBY
  CHINA
  WORLD
}

enum PetTripStatus {
  TRAVELING
  RETURNED
  REVEALED
  CANCELLED
}

enum TaskCategory {
  READING
  MATH
  EXERCISE
  CHORES
  ORGANIZING
  MUSIC
  CHINESE
  ENGLISH
  PE
  OTHER
}

enum TaskMode {
  UNTIMED
  TIMED
}

enum TaskExperienceKind {
  STANDARD
  HANZI_LEARNING
  HANZI_REVIEW
  CLOCK_LEARNING
  MAKE_TEN
  POEM_LEARNING
  POEM_REVIEW
}

enum ScheduleKind {
  DAILY
  WORKDAYS
  SELECTED_WEEKDAYS
  ONE_TIME
}

enum DailyTaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

enum AttemptStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  ROLLED_BACK
  TIMED_OUT
  ABANDONED
  DAY_ENDED
}

enum WishCategory {
  SPORTS
  GAMES
  TELEVISION
  TOYS
}

enum RedemptionStatus {
  PENDING
  ARRANGED
  COMPLETED
  CANCELLED
}

enum WishRedemptionType {
  ONE_TIME
  RECURRING
  STOCK
}

enum WishRecurrenceKind {
  DAILY
  WEEKLY
  INTERVAL
}

enum StarLedgerType {
  TASK_REWARD
  TASK_REWARD_REVERSAL
  DAILY_GOAL_BONUS
  PLANET_BONUS
  WISH_SPEND
  WISH_REFUND
  PET_CARE_SPEND
  PET_TRAVEL_SPEND
  PET_REFUND
  MANUAL_ADJUSTMENT
}

enum PlanetKey {
  MERCURY
  VENUS
  EARTH
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
}

enum AuditActorType {
  CHILD
  USER
  SYSTEM
}

enum LearningPracticeKind {
  GENERAL
  NEW_CONTENT
  REVIEW
  MIXED
}

enum HanziLearningStatus {
  LEARNING
  MASTERED
}

enum HanziSessionPhase {
  REVIEW
  NEW_LEARNING
  CONSOLIDATION
  COMPLETED
}

enum HanziSessionKind {
  COMBINED_LEGACY
  LEARNING
  REVIEW
}

enum PoemLearningStatus {
  LEARNING
  MASTERED
}

enum PoemSessionKind {
  LEARNING
  REVIEW
}

enum AiRecommendationKind {
  TASK_ADVICE
  REWARD_AUDIT
  SCHEDULE
}

enum AiRecommendationStatus {
  DRAFT
  APPLIED
  DISMISSED
}

enum WeeklyGrowthReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

model Family {
  id        String        @id @default(cuid())
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users               User[]
  children            ChildProfile[]
  aiConfig            FamilyAiConfig?
  minimaxConfig       FamilyMinimaxConfig?
  aiRecommendations   AiRecommendation[]
  weeklyGrowthReports WeeklyGrowthReport[]

  @@index([status])
}

model User {
  id           String        @id @default(cuid())
  familyId     String?
  username     String        @unique
  displayName  String
  passwordHash String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  family   Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@index([familyId, role])
  @@index([status])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ChildProfile {
  id                    String        @id @default(cuid())
  familyId              String
  loginCodeLookup       String        @unique
  loginCodeHash         String
  loginCodeLastFour     String
  status                AccountStatus @default(ACTIVE)
  nickname              String?
  petType               PetType?
  onboardingCompletedAt DateTime?
  dailyStarGoal         Int           @default(12)
  dailyGoalBonusEnabled Boolean       @default(false)
  dailyGoalBonusStars   Int           @default(0)
  starBalance           Int           @default(0)
  lifetimeStarsEarned   Int           @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  family                  Family                    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions                ChildSession[]
  taskTemplates           TaskTemplate[]
  dailyTasks              DailyTask[]
  taskAttempts            TaskAttempt[]
  activeTaskSlot          ActiveTaskSlot?
  starLedger              StarLedger[]
  wishRewards             WishReward[]
  redemptions             WishRedemption[]
  schedulePreference      ChildSchedulePreference?
  availabilitySlots       ChildAvailabilitySlot[]
  aiRecommendations       AiRecommendation[]
  weeklyGrowthReports     WeeklyGrowthReport[]
  planetProgress          PlanetProgress[]
  hanziSettings           HanziLearningSettings?
  hanziProgress           HanziLearningProgress[]
  hanziSessions           HanziLearningSession[]
  clockSettings           ClockLearningSettings?
  clockSessions           ClockLearningSession[]
  makeTenSettings         MakeTenLearningSettings?
  makeTenSessions         MakeTenLearningSession[]
  makeTenQuestionAttempts MakeTenQuestionAttempt[]
  makeTenFactProgress     MakeTenFactProgress[]
  poemSettings            PoemLearningSettings?
  poemProgress            PoemLearningProgress[]
  poemSessions            PoemLearningSession[]
  performanceMetrics      ChildPerformanceMetric[]
  leaderboardSettings     ChildLeaderboardSettings?
  petGrowthProfile        PetGrowthProfile?
  petCareActions          PetCareAction[]
  petTrips                PetTrip[]

  @@index([familyId, status])
}

model PetGrowthProfile {
  id                   String         @id @default(cuid())
  childId              String         @unique
  level                Int            @default(1)
  experience           Int            @default(0)
  growthStage          PetGrowthStage @default(BABY)
  satiety              Int            @default(78)
  hydration            Int            @default(82)
  satietySettledAt     DateTime       @default(now())
  hydrationSettledAt   DateTime       @default(now())
  travelEnabled        Boolean        @default(true)
  dailySpendLimitStars Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  child       ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  careActions PetCareAction[]
  trips       PetTrip[]
}

model PetCareAction {
  id              String      @id @default(cuid())
  childId         String
  profileId       String
  kind            PetCareKind
  itemKey         String
  starsSpent      Int
  statusBefore    Int
  statusAfter     Int
  experienceAdded Int
  idempotencyKey  String      @unique
  createdAt       DateTime    @default(now())

  child   ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile PetGrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
}

model PetTravelDestination {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  city         String
  country      String
  tier         PetTravelTier
  introduction String
  funFact      String
  imageUrl     String
  audioUrl     String?
  weight       Int           @default(100)
  sortOrder    Int           @default(0)
  isEnabled    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trips PetTrip[]

  @@index([tier, isEnabled, sortOrder])
}

model PetTrip {
  id                      String        @id @default(cuid())
  childId                 String
  profileId               String
  destinationId           String
  status                  PetTripStatus @default(TRAVELING)
  tierSnapshot            PetTravelTier
  destinationNameSnapshot String
  citySnapshot            String
  countrySnapshot         String
  introductionSnapshot    String
  funFactSnapshot         String
  imageUrlSnapshot        String
  audioUrlSnapshot        String?
  costStars               Int
  experienceRewardSnapshot Int
  experienceAwarded       Int           @default(0)
  departedAt              DateTime      @default(now())
  returnsAt               DateTime
  returnedAt              DateTime?
  revealedAt              DateTime?
  idempotencyKey          String        @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  child       ChildProfile         @relation(fields: [childId], references: [id], onDelete: Cascade)
  profile     PetGrowthProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  destination PetTravelDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([childId, status, departedAt])
  @@index([destinationId, departedAt])
}

model PetGrowthConfig {
  id                    String   @id @default("global")
  feedCostStars         Int      @default(2)
  feedRestore           Int      @default(28)
  feedExperience        Int      @default(6)
  drinkCostStars        Int      @default(1)
  drinkRestore          Int      @default(32)
  drinkExperience       Int      @default(4)
  satietyDecayMinutes   Int      @default(120)
  hydrationDecayMinutes Int      @default(90)
  nearbyCostStars       Int      @default(3)
  nearbyDurationMinutes Int      @default(2)
  nearbyExperience      Int      @default(12)
  chinaCostStars        Int      @default(10)
  chinaDurationMinutes  Int      @default(30)
  chinaExperience       Int      @default(24)
  worldCostStars        Int      @default(18)
  worldDurationMinutes  Int      @default(120)
  worldExperience       Int      @default(40)
  updatedAt             DateTime @updatedAt
}

model ChildSession {
  id         String   @id @default(cuid())
  childId    String
  tokenHash  String   @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, expiresAt])
}

model TaskTemplate {
  id                    String               @id @default(cuid())
  childId               String
  title                 String
  category              TaskCategory
  iconKey               String
  mode                  TaskMode
  experienceKind        TaskExperienceKind   @default(STANDARD)
  suggestedSeconds      Int?
  timeLimitSeconds      Int?
  baseStars             Int
  earlyBonusEnabled     Boolean              @default(false)
  earlyThresholdSeconds Int?
  earlyBonusStars       Int?
  repeatableDaily       Boolean              @default(false)
  scheduleKind          ScheduleKind
  weekdays              Int[]                @default([])
  oneTimeDate           DateTime?            @db.Date
  sortOrder             Int                  @default(0)
  isEnabled             Boolean              @default(true)
  archivedAt            DateTime?
  aiSchedulingEnabled   Boolean              @default(false)
  learningPracticeKind  LearningPracticeKind @default(GENERAL)
  targetSessionsPerWeek Int?
  minimumGapDays        Int?
  systemManaged         Boolean              @default(false)
  systemKey             String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyTasks DailyTask[]

  @@index([childId, isEnabled, archivedAt])
  @@index([childId, scheduleKind, oneTimeDate])
}

model FamilyAiConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  provider        String   @default("DEEPSEEK")
  model           String   @default("deepseek-v4-flash")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model FamilyMinimaxConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  provider        String   @default("MINIMAX")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model SystemMinimaxConfig {
  id              String   @id @default("default")
  provider        String   @default("MINIMAX")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MascotDialogue {
  id        String   @id @default(cuid())
  key       String   @unique
  context   String
  text      String
  audioUrl  String?
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([context, isEnabled, sortOrder])
}

model MascotAsset {
  id              String   @id @default(cuid())
  petType         PetType
  slot            String
  mediaUrl        String
  contentType     String
  fileName        String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petType, slot])
  @@index([slot])
}

model ChildLeaderboardSettings {
  id                       String    @id @default(cuid())
  childId                  String    @unique
  competitorGrowthPercent  Int       @default(100)
  dailyCompetitorStarDelta Int       @default(0)
  dailyAdjustmentDate      DateTime? @db.Date
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildSchedulePreference {
  id                    String   @id @default(cuid())
  childId               String   @unique
  maxDailyMinutes       Int      @default(40)
  maxConsecutiveMinutes Int      @default(15)
  minimumBreakMinutes   Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildAvailabilitySlot {
  id          String   @id @default(cuid())
  childId     String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, weekday, startMinute])
}

model AiRecommendation {
  id              String                 @id @default(cuid())
  familyId        String
  childId         String
  kind            AiRecommendationKind
  status          AiRecommendationStatus @default(DRAFT)
  promptVersion   String
  model           String
  requestPayload  Json
  responsePayload Json
  createdById     String
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, childId, kind, createdAt])
  @@index([status, createdAt])
}

model WeeklyGrowthReport {
  id              String                   @id @default(cuid())
  familyId        String
  childId         String
  weekStart       DateTime                 @db.Date
  weekEnd         DateTime                 @db.Date
  status          WeeklyGrowthReportStatus @default(GENERATING)
  promptVersion   String
  model           String?
  metricsPayload  Json
  responsePayload Json?
  errorCode       String?
  generatedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekStart])
  @@index([familyId, childId, weekStart])
  @@index([status, updatedAt])
}

model DailyTask {
  id                         String             @id @default(cuid())
  childId                    String
  templateId                 String
  taskDate                   DateTime           @db.Date
  status                     DailyTaskStatus    @default(PENDING)
  sortOrder                  Int
  titleSnapshot              String
  categorySnapshot           TaskCategory
  iconKeySnapshot            String
  modeSnapshot               TaskMode
  experienceKindSnapshot     TaskExperienceKind @default(STANDARD)
  suggestedSecondsSnapshot   Int?
  timeLimitSecondsSnapshot   Int?
  baseStarsSnapshot          Int
  earlyBonusEnabledSnapshot  Boolean
  earlyThresholdSecsSnapshot Int?
  earlyBonusStarsSnapshot    Int?
  repeatableDailySnapshot    Boolean            @default(false)
  completedAt                DateTime?
  completionDurationSeconds  Int?
  expiredAt                  DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  child    ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  template TaskTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  attempts TaskAttempt[]

  @@unique([childId, templateId, taskDate])
  @@index([childId, taskDate, status, sortOrder])
}

model HanziCharacter {
  id                String   @id @default(cuid())
  character         String   @unique
  internalPinyin    String
  meaning           String
  shapeHint         String
  sentence          String
  words             String[] @default([])
  wordAudioUrls     String[] @default([])
  imageKey          String   @default("default-hanzi")
  characterAudioUrl String?
  sentenceAudioUrl  String?
  sortOrder         Int      @default(0)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  progress HanziLearningProgress[]

  @@index([isEnabled, sortOrder])
}

model HanziLearningSettings {
  id                         String   @id @default(cuid())
  childId                    String   @unique
  newCharactersPerDay        Int      @default(3)
  reviewDailyLimit           Int      @default(25)
  consolidationQuestionCount Int      @default(3)
  reviewTaskStars            Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model HanziLearningProgress {
  id               String              @id @default(cuid())
  childId          String
  characterId      String
  status           HanziLearningStatus @default(LEARNING)
  learnedDate      DateTime            @db.Date
  reviewStage      Int                 @default(0)
  nextReviewDate   DateTime?           @db.Date
  isDifficult      Boolean             @default(false)
  consecutiveWrong Int                 @default(0)
  lastReviewedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  child     ChildProfile   @relation(fields: [childId], references: [id], onDelete: Cascade)
  character HanziCharacter @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([childId, characterId])
  @@index([childId, status, nextReviewDate])
}

model HanziLearningSession {
  id                     String            @id @default(cuid())
  childId                String
  taskAttemptId          String            @unique
  sessionDate            DateTime          @db.Date
  kind                   HanziSessionKind  @default(COMBINED_LEGACY)
  phase                  HanziSessionPhase
  reviewCharacterIds     String[]          @default([])
  reviewIndex            Int               @default(0)
  reviewKnownIds         String[]          @default([])
  reviewUnknownIds       String[]          @default([])
  newCharacterIds        String[]          @default([])
  newIndex               Int               @default(0)
  consolidationQuestions Json
  questionIndex          Int               @default(0)
  consolidationCorrect   Int               @default(0)
  consolidationTotal     Int               @default(0)
  completedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt  @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)

  @@index([childId, sessionDate])
}

model ClockLearningSettings {
  id              String   @id @default(cuid())
  childId         String   @unique
  questionsPerDay Int      @default(5)
  minuteStep      Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ClockLearningSession {
  id             String    @id @default(cuid())
  childId        String
  taskAttemptId  String    @unique
  sessionDate    DateTime  @db.Date
  minuteStep     Int
  questions      Json
  answers        Json
  currentIndex   Int       @default(0)
  correctCount   Int       @default(0)
  totalQuestions Int
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt  @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)

  @@index([childId, completedAt])
  @@index([childId, sessionDate])
}

model MakeTenLearningSettings {
  id                  String   @id @default(cuid())
  childId             String   @unique
  questionsPerDay     Int      @default(20)
  secondsPerQuestion  Float    @default(5)
  passAccuracyPercent Int      @default(80)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model MakeTenLearningSession {
  id                  String    @id @default(cuid())
  childId             String
  taskAttemptId       String    @unique
  sessionDate         DateTime  @db.Date
  secondsPerQuestion  Float
  passAccuracyPercent Int
  questions           Json
  answers             Json
  currentIndex        Int       @default(0)
  correctCount        Int       @default(0)
  totalQuestions      Int
  passed              Boolean?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  child            ChildProfile             @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt      TaskAttempt              @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)
  questionAttempts MakeTenQuestionAttempt[]

  @@index([childId, completedAt])
  @@index([childId, sessionDate])
}

model MakeTenQuestionAttempt {
  id             String   @id @default(cuid())
  childId        String
  sessionId      String
  questionIndex  Int
  target         Int
  selectedNumber Int?
  correct        Boolean
  timedOut       Boolean
  responseMs     Int
  answeredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  child   ChildProfile           @relation(fields: [childId], references: [id], onDelete: Cascade)
  session MakeTenLearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionIndex])
  @@index([childId, target, answeredAt])
}

model MakeTenFactProgress {
  id               String    @id @default(cuid())
  childId          String
  target           Int
  attemptCount     Int       @default(0)
  correctCount     Int       @default(0)
  totalResponseMs  Int       @default(0)
  recentAccuracy   Float?
  recentResponseMs Float?
  consecutiveWrong Int       @default(0)
  lastAnsweredAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, target])
  @@index([childId, lastAnsweredAt])
}

model Poem {
  id        String   @id @default(cuid())
  title     String
  dynasty   String
  author    String
  grade     Int
  semester  String
  content   String
  imageUrl  String?
  audioUrl  String?
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress PoemLearningProgress[]

  @@unique([title, dynasty, author, grade, semester])
  @@index([isEnabled, grade, semester, sortOrder])
}

model PoemLearningSettings {
  id                String   @id @default(cuid())
  childId           String   @unique
  enabled           Boolean  @default(false)
  learningWeekdays  Int[]    @default([2, 4])
  learningTaskStars Int      @default(2)
  reviewTaskStars   Int      @default(2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model PoemLearningProgress {
  id             String             @id @default(cuid())
  childId        String
  poemId         String
  status         PoemLearningStatus @default(LEARNING)
  learnedDate    DateTime           @db.Date
  reviewStage    Int                @default(0)
  nextReviewDate DateTime?          @db.Date
  lastReviewedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  poem  Poem         @relation(fields: [poemId], references: [id], onDelete: Restrict)

  @@unique([childId, poemId])
  @@index([childId, status, nextReviewDate])
}

model PoemLearningSession {
  id               String          @id @default(cuid())
  childId          String
  taskAttemptId    String          @unique
  sessionDate      DateTime        @db.Date
  kind             PoemSessionKind
  poemIds          String[]        @default([])
  currentIndex     Int             @default(0)
  completedPoemIds String[]        @default([])
  forgottenPoemIds String[]        @default([])
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt  @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)

  @@index([childId, sessionDate])
}

model TaskAttempt {
  id                 String        @id @default(cuid())
  childId            String
  dailyTaskId        String
  attemptNumber      Int
  status             AttemptStatus @default(RUNNING)
  startedAt          DateTime      @default(now())
  pausedAt           DateTime?
  totalPausedSeconds Int           @default(0)
  endedAt            DateTime?
  elapsedSeconds     Int?
  remainingSeconds   Int?
  baseStarsAwarded   Int           @default(0)
  bonusStarsAwarded  Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  child          ChildProfile            @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyTask      DailyTask               @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  reward         StarLedger?
  activeSlot     ActiveTaskSlot?
  hanziSession   HanziLearningSession?
  clockSession   ClockLearningSession?
  makeTenSession MakeTenLearningSession?
  poemSession    PoemLearningSession?

  @@unique([dailyTaskId, attemptNumber])
  @@index([childId, status])
  @@index([dailyTaskId, status])
}

model ActiveTaskSlot {
  childId   String   @id
  attemptId String   @unique
  createdAt DateTime @default(now())

  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  attempt TaskAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model StarLedger {
  id             String         @id @default(cuid())
  childId        String
  taskAttemptId  String?        @unique
  type           StarLedgerType
  amount         Int
  balanceAfter   Int
  reason         String?
  referenceId    String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt? @relation(fields: [taskAttemptId], references: [id], onDelete: Restrict)

  @@index([childId, createdAt])
  @@index([referenceId])
}

model PlanetProgress {
  id                    String    @id @default(cuid())
  childId               String
  planet                PlanetKey
  requiredLifetimeStars Int
  bonusStars            Int
  awardedBonusStars     Int?
  unlockedAt            DateTime?
  notifiedAt            DateTime?
  celebratedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, planet])
  @@index([childId, unlockedAt])
}

model WishReward {
  id                     String              @id @default(cuid())
  childId                String
  category               WishCategory
  title                  String
  imageKey               String
  costStars              Int
  redemptionType         WishRedemptionType  @default(ONE_TIME)
  recurrenceKind         WishRecurrenceKind?
  recurrenceIntervalDays Int?
  stockRemaining         Int?
  sortOrder              Int                 @default(0)
  isEnabled              Boolean             @default(true)
  archivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  child                ChildProfile              @relation(fields: [childId], references: [id], onDelete: Cascade)
  redemptions          WishRedemption[]
  activeRedemptionSlot ActiveWishRedemptionSlot?

  @@index([childId, category, isEnabled, sortOrder])
}

model WishRedemption {
  id                             String              @id @default(cuid())
  childId                        String
  wishRewardId                   String
  status                         RedemptionStatus    @default(PENDING)
  titleSnapshot                  String
  categorySnapshot               WishCategory
  costStarsSnapshot              Int
  redemptionTypeSnapshot         WishRedemptionType
  recurrenceKindSnapshot         WishRecurrenceKind?
  recurrenceIntervalDaysSnapshot Int?
  requestedAt                    DateTime            @default(now())
  arrangedAt                     DateTime?
  completedAt                    DateTime?
  cancelledAt                    DateTime?
  cancelReason                   String?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  child      ChildProfile              @relation(fields: [childId], references: [id], onDelete: Cascade)
  wishReward WishReward                @relation(fields: [wishRewardId], references: [id], onDelete: Restrict)
  activeSlot ActiveWishRedemptionSlot?

  @@index([childId, status, requestedAt])
  @@index([wishRewardId, status])
}

model ActiveWishRedemptionSlot {
  wishRewardId String   @id
  redemptionId String   @unique
  createdAt    DateTime @default(now())

  wishReward WishReward     @relation(fields: [wishRewardId], references: [id], onDelete: Cascade)
  redemption WishRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
}

model ChildPerformanceMetric {
  id               String   @id @default(cuid())
  childId          String
  kind             String
  operation        String
  path             String
  method           String?
  status           Int?
  requestId        String?
  totalMs          Float
  serverMs         Float?
  clientOverheadMs Float?
  apiTotalMs       Float?
  nonApiMs         Float?
  ttfbMs           Float?
  downloadMs       Float?
  transferSize     Int?
  route            String?
  visibilityState  String?
  online           Boolean?
  effectiveType    String?
  connectionRttMs  Float?
  downlinkMbps     Float?
  createdAt        DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@index([childId, operation, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id           String         @id @default(cuid())
  actorType    AuditActorType
  actorId      String?
  familyId     String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime       @default(now())

  @@index([familyId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([resourceType, resourceId])
}
