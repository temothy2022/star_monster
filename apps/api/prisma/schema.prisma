  reward              StarLedger?
  activeSlot          ActiveTaskSlot?
  hanziSession        HanziLearningSession?
  clockSession        ClockLearningSession?
  makeTenSession      MakeTenLearningSession?
  mathPracticeSession MathPracticeSession?
  poemSession         PoemLearningSession?

  @@unique([dailyTaskId, attemptNumber])
  @@index([childId, status])
  @@index([dailyTaskId, status])
}

model ActiveTaskSlot {
