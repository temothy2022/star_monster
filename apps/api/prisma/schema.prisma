generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum PetType {
  DOUYA
  PAOPAO
  TUANTUAN
  MILU
  SHANSHAN
}

enum TaskCategory {
  READING
  MATH
  EXERCISE
  CHORES
  ORGANIZING
  MUSIC
  CHINESE
  ENGLISH
  PE
  OTHER
}

enum TaskMode {
  UNTIMED
  TIMED
}

enum TaskExperienceKind {
  STANDARD
  HANZI_LEARNING
}

enum ScheduleKind {
  DAILY
  WORKDAYS
  SELECTED_WEEKDAYS
  ONE_TIME
}

enum DailyTaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

enum AttemptStatus {
  RUNNING
  PAUSED
  COMPLETED
  TIMED_OUT
  ABANDONED
  DAY_ENDED
}

enum WishCategory {
  SPORTS
  GAMES
  TELEVISION
  TOYS
}

enum RedemptionStatus {
  PENDING
  ARRANGED
  COMPLETED
  CANCELLED
}

enum WishRedemptionType {
  ONE_TIME
  RECURRING
  STOCK
}

enum WishRecurrenceKind {
  DAILY
  WEEKLY
  INTERVAL
}

enum StarLedgerType {
  TASK_REWARD
  DAILY_GOAL_BONUS
  PLANET_BONUS
  WISH_SPEND
  WISH_REFUND
  MANUAL_ADJUSTMENT
}

enum PlanetKey {
  MERCURY
  VENUS
  EARTH
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
}

enum AuditActorType {
  CHILD
  USER
  SYSTEM
}

enum LearningPracticeKind {
  GENERAL
  NEW_CONTENT
  REVIEW
  MIXED
}

enum HanziLearningStatus {
  LEARNING
  MASTERED
}

enum HanziSessionPhase {
  REVIEW
  NEW_LEARNING
  CONSOLIDATION
  COMPLETED
}

enum AiRecommendationKind {
  TASK_ADVICE
  REWARD_AUDIT
  SCHEDULE
}

enum AiRecommendationStatus {
  DRAFT
  APPLIED
  DISMISSED
}

model Family {
  id        String        @id @default(cuid())
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users             User[]
  children          ChildProfile[]
  aiConfig          FamilyAiConfig?
  aiRecommendations AiRecommendation[]

  @@index([status])
}

model User {
  id           String        @id @default(cuid())
  familyId     String?
  username     String        @unique
  displayName  String
  passwordHash String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  family   Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@index([familyId, role])
  @@index([status])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ChildProfile {
  id                    String        @id @default(cuid())
  familyId              String
  loginCodeLookup       String        @unique
  loginCodeHash         String
  loginCodeLastFour     String
  status                AccountStatus @default(ACTIVE)
  nickname              String?
  petType               PetType?
  onboardingCompletedAt DateTime?
  dailyStarGoal         Int           @default(12)
  dailyGoalBonusEnabled Boolean       @default(false)
  dailyGoalBonusStars   Int           @default(0)
  starBalance           Int           @default(0)
  lifetimeStarsEarned   Int           @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  family             Family                   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions           ChildSession[]
  taskTemplates      TaskTemplate[]
  dailyTasks         DailyTask[]
  taskAttempts       TaskAttempt[]
  activeTaskSlot     ActiveTaskSlot?
  starLedger         StarLedger[]
  wishRewards        WishReward[]
  redemptions        WishRedemption[]
  schedulePreference ChildSchedulePreference?
  availabilitySlots  ChildAvailabilitySlot[]
  aiRecommendations  AiRecommendation[]
  planetProgress     PlanetProgress[]
  hanziSettings      HanziLearningSettings?
  hanziProgress      HanziLearningProgress[]
  hanziSessions      HanziLearningSession[]

  @@index([familyId, status])
}

model ChildSession {
  id         String   @id @default(cuid())
  childId    String
  tokenHash  String   @unique
  deviceName String?
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, expiresAt])
}

model TaskTemplate {
  id                    String               @id @default(cuid())
  childId               String
  title                 String
  category              TaskCategory
  iconKey               String
  mode                  TaskMode
  experienceKind        TaskExperienceKind   @default(STANDARD)
  suggestedSeconds      Int?
  timeLimitSeconds      Int?
  baseStars             Int
  earlyBonusEnabled     Boolean              @default(false)
  earlyThresholdSeconds Int?
  earlyBonusStars       Int?
  repeatableDaily       Boolean              @default(false)
  scheduleKind          ScheduleKind
  weekdays              Int[]                @default([])
  oneTimeDate           DateTime?            @db.Date
  sortOrder             Int                  @default(0)
  isEnabled             Boolean              @default(true)
  archivedAt            DateTime?
  aiSchedulingEnabled   Boolean              @default(false)
  learningPracticeKind  LearningPracticeKind @default(GENERAL)
  targetSessionsPerWeek Int?
  minimumGapDays        Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyTasks DailyTask[]

  @@index([childId, isEnabled, archivedAt])
  @@index([childId, scheduleKind, oneTimeDate])
}

model FamilyAiConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  provider        String   @default("DEEPSEEK")
  model           String   @default("deepseek-v4-flash")
  encryptedApiKey String
  encryptionIv    String
  encryptionTag   String
  apiKeyLastFour  String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model ChildSchedulePreference {
  id                    String   @id @default(cuid())
  childId               String   @unique
  maxDailyMinutes       Int      @default(40)
  maxConsecutiveMinutes Int      @default(15)
  minimumBreakMinutes   Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ChildAvailabilitySlot {
  id          String   @id @default(cuid())
  childId     String
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, weekday, startMinute])
}

model AiRecommendation {
  id              String                 @id @default(cuid())
  familyId        String
  childId         String
  kind            AiRecommendationKind
  status          AiRecommendationStatus @default(DRAFT)
  promptVersion   String
  model           String
  requestPayload  Json
  responsePayload Json
  createdById     String
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, childId, kind, createdAt])
  @@index([status, createdAt])
}

model DailyTask {
  id                         String             @id @default(cuid())
  childId                    String
  templateId                 String
  taskDate                   DateTime           @db.Date
  status                     DailyTaskStatus    @default(PENDING)
  sortOrder                  Int
  titleSnapshot              String
  categorySnapshot           TaskCategory
  iconKeySnapshot            String
  modeSnapshot               TaskMode
  experienceKindSnapshot     TaskExperienceKind @default(STANDARD)
  suggestedSecondsSnapshot   Int?
  timeLimitSecondsSnapshot   Int?
  baseStarsSnapshot          Int
  earlyBonusEnabledSnapshot  Boolean
  earlyThresholdSecsSnapshot Int?
  earlyBonusStarsSnapshot    Int?
  repeatableDailySnapshot    Boolean            @default(false)
  completedAt                DateTime?
  completionDurationSeconds  Int?
  expiredAt                  DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  child    ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  template TaskTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  attempts TaskAttempt[]

  @@unique([childId, templateId, taskDate])
  @@index([childId, taskDate, status, sortOrder])
}

model HanziCharacter {
  id                String   @id @default(cuid())
  character         String   @unique
  internalPinyin    String
  meaning           String
  shapeHint         String
  sentence          String
  words             String[] @default([])
  wordAudioUrls     String[] @default([])
  imageKey          String   @default("default-hanzi")
  characterAudioUrl String?
  sentenceAudioUrl  String?
  sortOrder         Int      @default(0)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  progress HanziLearningProgress[]

  @@index([isEnabled, sortOrder])
}

model HanziLearningSettings {
  id                         String   @id @default(cuid())
  childId                    String   @unique
  newCharactersPerDay        Int      @default(3)
  reviewDailyLimit           Int      @default(25)
  consolidationQuestionCount Int      @default(3)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model HanziLearningProgress {
  id               String              @id @default(cuid())
  childId          String
  characterId      String
  status           HanziLearningStatus @default(LEARNING)
  learnedDate      DateTime            @db.Date
  reviewStage      Int                 @default(0)
  nextReviewDate   DateTime?           @db.Date
  isDifficult      Boolean             @default(false)
  consecutiveWrong Int                 @default(0)
  lastReviewedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  child     ChildProfile   @relation(fields: [childId], references: [id], onDelete: Cascade)
  character HanziCharacter @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([childId, characterId])
  @@index([childId, status, nextReviewDate])
}

model HanziLearningSession {
  id                     String            @id @default(cuid())
  childId                String
  taskAttemptId          String            @unique
  sessionDate            DateTime          @db.Date
  phase                  HanziSessionPhase
  reviewCharacterIds     String[]          @default([])
  reviewIndex            Int               @default(0)
  reviewKnownIds         String[]          @default([])
  reviewUnknownIds       String[]          @default([])
  newCharacterIds        String[]          @default([])
  newIndex               Int               @default(0)
  consolidationQuestions Json
  questionIndex          Int               @default(0)
  consolidationCorrect   Int               @default(0)
  consolidationTotal     Int               @default(0)
  completedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt  @relation(fields: [taskAttemptId], references: [id], onDelete: Cascade)

  @@index([childId, sessionDate])
}

model TaskAttempt {
  id                 String        @id @default(cuid())
  childId            String
  dailyTaskId        String
  attemptNumber      Int
  status             AttemptStatus @default(RUNNING)
  startedAt          DateTime      @default(now())
  pausedAt           DateTime?
  totalPausedSeconds Int           @default(0)
  endedAt            DateTime?
  elapsedSeconds     Int?
  remainingSeconds   Int?
  baseStarsAwarded   Int           @default(0)
  bonusStarsAwarded  Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  child        ChildProfile          @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyTask    DailyTask             @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  reward       StarLedger?
  activeSlot   ActiveTaskSlot?
  hanziSession HanziLearningSession?

  @@unique([dailyTaskId, attemptNumber])
  @@index([childId, status])
  @@index([dailyTaskId, status])
}

model ActiveTaskSlot {
  childId   String   @id
  attemptId String   @unique
  createdAt DateTime @default(now())

  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  attempt TaskAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model StarLedger {
  id             String         @id @default(cuid())
  childId        String
  taskAttemptId  String?        @unique
  type           StarLedgerType
  amount         Int
  balanceAfter   Int
  reason         String?
  referenceId    String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt? @relation(fields: [taskAttemptId], references: [id], onDelete: Restrict)

  @@index([childId, createdAt])
  @@index([referenceId])
}

model PlanetProgress {
  id                    String    @id @default(cuid())
  childId               String
  planet                PlanetKey
  requiredLifetimeStars Int
  bonusStars            Int
  awardedBonusStars     Int?
  unlockedAt            DateTime?
  notifiedAt            DateTime?
  celebratedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, planet])
  @@index([childId, unlockedAt])
}

model WishReward {
  id                     String              @id @default(cuid())
  childId                String
  category               WishCategory
  title                  String
  imageKey               String
  costStars              Int
  redemptionType         WishRedemptionType  @default(ONE_TIME)
  recurrenceKind         WishRecurrenceKind?
  recurrenceIntervalDays Int?
  stockRemaining         Int?
  sortOrder              Int                 @default(0)
  isEnabled              Boolean             @default(true)
  archivedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  child                ChildProfile              @relation(fields: [childId], references: [id], onDelete: Cascade)
  redemptions          WishRedemption[]
  activeRedemptionSlot ActiveWishRedemptionSlot?

  @@index([childId, category, isEnabled, sortOrder])
}

model WishRedemption {
  id                             String              @id @default(cuid())
  childId                        String
  wishRewardId                   String
  status                         RedemptionStatus    @default(PENDING)
  titleSnapshot                  String
  categorySnapshot               WishCategory
  costStarsSnapshot              Int
  redemptionTypeSnapshot         WishRedemptionType
  recurrenceKindSnapshot         WishRecurrenceKind?
  recurrenceIntervalDaysSnapshot Int?
  requestedAt                    DateTime            @default(now())
  arrangedAt                     DateTime?
  completedAt                    DateTime?
  cancelledAt                    DateTime?
  cancelReason                   String?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  child      ChildProfile              @relation(fields: [childId], references: [id], onDelete: Cascade)
  wishReward WishReward                @relation(fields: [wishRewardId], references: [id], onDelete: Restrict)
  activeSlot ActiveWishRedemptionSlot?

  @@index([childId, status, requestedAt])
  @@index([wishRewardId, status])
}

model ActiveWishRedemptionSlot {
  wishRewardId String   @id
  redemptionId String   @unique
  createdAt    DateTime @default(now())

  wishReward WishReward     @relation(fields: [wishRewardId], references: [id], onDelete: Cascade)
  redemption WishRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String         @id @default(cuid())
  actorType    AuditActorType
  actorId      String?
  familyId     String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime       @default(now())

  @@index([familyId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([resourceType, resourceId])
}
