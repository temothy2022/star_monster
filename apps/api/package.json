{
  "name": "@star-monsters/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "HOST=0.0.0.0 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "poem:import": "tsx prisma/import-poems.ts",
    "poem:import-assets": "tsx prisma/import-poem-assets.ts",
    "pet:generate-audio": "tsx prisma/generate-pet-destination-audio.ts",
    "performance:export": "node --import tsx prisma/export-performance-metrics.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@star-monsters/math-practice": "workspace:*",
    "@prisma/client": "6.19.0",
    "fastify": "^5.6.2",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
