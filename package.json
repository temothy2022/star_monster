{
  "name": "star-monsters-expedition",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @star-monsters/design-lab dev",
    "dev:all": "pnpm --parallel --filter @star-monsters/api --filter @star-monsters/design-lab --filter @star-monsters/parent-admin --filter @star-monsters/super-admin dev",
    "dev:child": "pnpm --filter @star-monsters/design-lab dev",
    "dev:parent": "pnpm --filter @star-monsters/parent-admin dev",
    "dev:super": "pnpm --filter @star-monsters/super-admin dev",
    "dev:api": "pnpm --filter @star-monsters/api dev",
    "local:ipad": "bash scripts/start-local-ipad-test.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @star-monsters/api db:generate",
    "db:migrate": "pnpm --filter @star-monsters/api db:migrate",
    "db:deploy": "pnpm --filter @star-monsters/api db:deploy",
    "db:push": "pnpm --filter @star-monsters/api db:push",
    "db:seed": "pnpm --filter @star-monsters/api db:seed",
    "poem:import": "pnpm --filter @star-monsters/api poem:import",
    "assets:audit": "pnpm --filter @star-monsters/design-lab assets:audit",
    "assets:webp": "pnpm --filter @star-monsters/design-lab assets:webp",
    "hanzi:prepare": "node scripts/prepare-hanzi-assets-input.mjs",
    "hanzi:apply-reviewed": "node scripts/apply-reviewed-hanzi-content.mjs",
    "hanzi:generate": "node scripts/generate-hanzi-minimax-sample.mjs",
    "hanzi:compress-images": "pnpm --filter @star-monsters/design-lab exec node ../../scripts/compress-hanzi-images.mjs",
    "hanzi:compress-images:check": "pnpm --filter @star-monsters/design-lab exec node ../../scripts/compress-hanzi-images.mjs --check",
    "assets:compress-audio": "node scripts/compress-audio-assets.mjs",
    "assets:fingerprint-media": "node scripts/fingerprint-media-assets.mjs",
    "hanzi:deploy-assets": "bash scripts/deploy-hanzi-assets.sh",
    "hanzi:import": "pnpm --filter @star-monsters/api exec tsx prisma/import-hanzi-assets.ts",
    "poem:generate-assets": "pnpm --filter @star-monsters/design-lab exec node ../../scripts/generate-poem-minimax-assets.mjs",
    "poem:deploy-assets": "bash scripts/deploy-poem-assets.sh",
    "poem:import-assets": "pnpm --filter @star-monsters/api exec tsx prisma/import-poem-assets.ts",
    "pet:reset-test-status": "pnpm --filter @star-monsters/api exec prisma db execute --schema prisma/schema.prisma --file ../../scripts/reset-test-pet-status.sql",
    "performance:export": "pnpm --filter @star-monsters/api performance:export",
    "deploy:production": "bash scripts/deploy-production.sh"
  }
}
