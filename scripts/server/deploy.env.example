# This file lives on the server, outside the Git repository:
#   sudo mkdir -p /etc/star-monsters
#   sudo cp scripts/server/deploy.env.example /etc/star-monsters/deploy.env
#   sudo chmod 600 /etc/star-monsters/deploy.env

# Directories used by the existing Nginx site configuration. These may point
# directly at the workspace dist folders; apply-release.sh detects that case.
CHILD_WEB_ROOT=/opt/star-monsters/apps/design-lab/dist
PARENT_WEB_ROOT=/opt/star-monsters/apps/parent-admin/dist
SUPER_WEB_ROOT=/opt/star-monsters/apps/super-admin/dist
PACKING_WEB_ROOT=/opt/star-monsters/apps/travel-packing/dist

# The systemd service that runs apps/api.
API_SERVICE=star-monsters-api.service

# Parent-admin uploads are stored separately from generated offline assets.
HANZI_UPLOAD_DIR=/opt/star-monsters/hanzi-assets/v1/uploads
POEM_UPLOAD_DIR=/opt/star-monsters/poem-assets/v1/uploads
PET_STATIC_DIR=/opt/star-monsters/pet-assets
NGINX_PERFORMANCE_CONF=/etc/nginx/conf.d/star-monsters-performance.conf
NGINX_SITE_CONFIG=/etc/nginx/sites-enabled/star-monsters
MAX_UPLOAD_SIZE=32m
