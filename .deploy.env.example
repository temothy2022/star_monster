# Copy this file to .deploy.env and fill in your own server information.
# .deploy.env is ignored by Git and must never contain a password or API key.

# The public IP or domain of your server.
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
DEPLOY_IDENTITY_FILE=/Users/your-name/.ssh/star_monsters_deploy

# The directory on the server that contains package.json.
DEPLOY_PATH=/opt/star-monsters
